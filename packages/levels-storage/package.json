{
  "name": "@actualwave/type-checker-levels-storage",
  "description": "Type information storage",
  "version": "0.0.5",
  "main": "index.js",
  "types": "index.d.ts",
  "keywords": [
    "js",
    "javascript",
    "proxy",
    "tree",
    "E4X"
  ],
  "homepage": "https://github.com/burdiuz/js-type-checkers",
  "bugs": {
    "url": "https://github.com/burdiuz/js-type-checkers/issues",
    "email": "burdiuz@gmail.com"
  },
  "license": "MIT",
  "author": "Oleg Galaburda <burdiuz@gmail.com> (http://actualwave.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/burdiuz/js-type-checkers.git"
  },
  "dependencies": {
    "@actualwave/map-of-sets": "0.0.3"
  },
  "peerDependencies": {
    "@actualwave/type-checkers": ">=0.1.1"
  },
  "jest": {
    "testEnvironment": "node",
    "injectGlobals": false,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "node"
          }
        }
      ]
    },
    "testMatch": [
      "**/*.spec.ts"
    ],
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.spec.ts",
      "!**/node_modules/**"
    ]
  },
  "scripts": {
    "build": "rollup --config",
    "build:watch": "rollup --config --watch",
    "test": "jest --colors",
    "test:watch": "jest --colors --watch"
  }
}
